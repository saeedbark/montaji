# ───────────────────────────────────────────────────────────────
#  مفاتيح المساعد الذكي في مونتاجي
#  ضع مفتاحاً واحداً على الأقل ثم احفظ الملف — لا حاجة لإعادة التشغيل.
#  هذا الملف يبقى على جهازك فقط: لا يُرفع إلى Git ولا يصل إلى المتصفح.
# ───────────────────────────────────────────────────────────────

# Google Gemini — مفتاح مجاني من https://aistudio.google.com/apikey
GEMINI_API_KEY=

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic Claude — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# OpenRouter (مئات النماذج بمفتاح واحد) — https://openrouter.ai/keys
OPENROUTER_API_KEY=

# ── اختياري ────────────────────────────────────────────────────

# إن وضعت أكثر من مفتاح فاختر المزوّد هنا: gemini | openai | anthropic | openrouter | ollama | custom
AI_PROVIDER=

# اسم النموذج. اتركه فارغاً لاستخدام النموذج الافتراضي للمزوّد.
# أمثلة: gemini-3.6-flash ، gpt-5.4-mini ، claude-sonnet-5-5
AI_MODEL=

# إرسال صور مصغّرة من ملفاتك إلى المزوّد كي «يرى» المساعد محتواها (on / off)
AI_VISION=on

# أي خدمة متوافقة مع OpenAI (Groq, DeepSeek, Mistral, LM Studio ...):
#   AI_PROVIDER=custom  مع  AI_BASE_URL  و  AI_API_KEY  و  AI_MODEL
# نموذج محلي عبر Ollama دون إنترنت:
#   AI_PROVIDER=ollama  مع  AI_MODEL=اسم-النموذج
AI_BASE_URL=
AI_API_KEY=
